# Copy this file to .env (same folder as predict.py) and fill in real values.
# NEVER commit the actual .env file to GitHub — only this .env.example template.

GEE_PROJECT_ID=your-google-cloud-project-id
# Only needed if using a service account for a deployed backend. For local
# development, `earthengine authenticate` + GEE_PROJECT_ID is enough.
GEE_SERVICE_ACCOUNT_JSON=./secrets/gee-key.json

# From console.groq.com — free, no card required. Used by chatbot_backend.py.
GROQ_API_KEY=your_groq_key_here

# Optional — only if you wire in real rainfall data later
OPENWEATHERMAP_API_KEY=your_key_here
